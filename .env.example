# Copy this file to .env for local deployment. Never commit the resulting .env.

# Web authentication. deploy.sh generates missing secrets and passwords.
FLASK_SECRET_KEY=
FLASK_AUTH_USERNAME=admin
FLASK_AUTH_PASSWORD=

# Local executable overrides. Leave blank when commands are already on PATH.
CONDA_BIN_PATH=
CLAUDE_BIN_PATH=
CODEX_BIN_PATH=

# Local service ports.
FLASK_PORT=5000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=8443

# Optional Maze room password. Required only when MAZE_ENABLED is true.
STATION_MAZE_PASSWORD=

# Provider credentials. Configure only providers you use.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional OpenAI-compatible or provider-compatible endpoints.
GOOGLE_GEMINI_BASE_URL=
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
XAI_BASE_URL=

# Optional provider-specific proxies.
GOOGLE_GEMINI_HTTP_PROXY=
GOOGLE_GEMINI_HTTPS_PROXY=
OPENAI_HTTP_PROXY=
OPENAI_HTTPS_PROXY=
ANTHROPIC_HTTP_PROXY=
ANTHROPIC_HTTPS_PROXY=
XAI_HTTP_PROXY=
XAI_HTTPS_PROXY=

# Optional Research Center coder credentials and endpoint.
CODEX_API_KEY=
CODEX_BASE_URL=
CLAUDE_CODE_API_KEY=

# Optional External Counter credentials and endpoint.
EXTERNAL_OPENAI_API_KEY=
EXTERNAL_OPENAI_BASE_URL=
